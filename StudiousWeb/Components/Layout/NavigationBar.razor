@rendermode InteractiveServer

<div class="navbar studious-nav-bg-main">
    <div class="container">
        <a class="navbar-brand text-white" href="">
            <img src="Assets\Images\Studious_Logo.svg" width="43" height="32">
            Studious
        </a>
        <div class="navbar-nav flex-row gap-4">
            <NavLink class="nav-link text-white" href="">Home</NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-link text-white" href="Study">Study Time</NavLink>
                    <NavLink class="nav-link text-white" href="ManageDB">Edit Sets</NavLink>
                </Authorized>
            </AuthorizeView>
            <NavLink class="nav-link text-white" href="">About</NavLink>
        </div>
       
        <div class="dropdown">
            <button class="btn text-white border-0 shadow-none dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <AuthorizeView>
                    <Authorized>
                        @context.User.Identity?.Name!
                    </Authorized>
                    <NotAuthorized>
                        Manage User
                    </NotAuthorized>
                </AuthorizeView>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-person" viewBox="0 0 16 16">
                    <path d="M12 1a1 1 0 0 1 1 1v10.755S12 11 8 11s-5 1.755-5 1.755V2a1 1 0 0 1 1-1zM4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                    <path d="M8 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6" />
                </svg>
            </button>
            <ul class="dropdown-menu">
                <AuthorizeView>
                    <Authorized>
                        <li class="dropdown-item"><NavLink class="nav-link" href="">Manage Account</NavLink></li>
                        <li class="dropdown-item"><NavLink class="nav-item" href="">Sign out</NavLink></li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="dropdown-item"><NavLink class="nav-link" href="login">Login</NavLink></li>
                        <li class="dropdown-item"><NavLink class="nav-link" href="registration">Register</NavLink></li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</div>