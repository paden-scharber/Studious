@page "/managedb"
@page "/managedb/{StudySetName}"
@rendermode InteractiveServer
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
@if (string.IsNullOrEmpty(StudySetName))
{
    <!-- Set Selection View -->
    <div><br /> </div>
    <div class="d-flex justify-content-between align-items-center">
        <h3 class="mb-0">@context.User.Identity? Study Sets</h3>
        <button type="button" class="btn btn-success btn-sm" @onclick="() => showModal = true">
            <i class="bi bi-plus-circle"></i> New Study Set
        </button>
    </div>

    <hr />
    @if (showModal)
    {
        <div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000;">
            <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:white; padding:2rem; border-radius:8px; min-width:300px;">
                <h5>New Study Set</h5>
                <input class="form-control" @bind="newStudySetName" placeholder="Study Set Name" />
                <div class="mt-3">
                    <button class="btn btn-success" @onclick="ConfirmNewSet">
                        <i class="bi bi-check-lg"></i> Confirm
                    </button>
                    <button class="btn btn-secondary ms-2" @onclick="() => showModal = false">
                        <i class="bi bi-x-lg"></i> Cancel
                    </button>
                </div>
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    <div> <br /> </div>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var set in studySets)
        {
            <div class="col">
                <div class="card h-100 text-center" style="cursor:pointer;" @onclick="() => SelectSet(set)">
                    <div class="card-body">
                        <i class="bi @GetIconForSet(set)" style="font-size: 2rem;"></i>
                        <h5 class="card-title mt-2">@set</h5>
                    </div>
                </div>
            </div>
        }
    </div>
    
}
else
{
    <!-- CRUD View -->
    <div><br /></div>
    <div class="d-flex align-items-center mb-3">
        <button class="btn btn-secondary btn-sm me-3" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back
        </button>
        <h3 class="mb-0">@StudySetName</h3>
    </div>
    <hr />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    <p> 
        New Card will create one new card. Import File allows you to create multiple cards at once.
        File must be CSV or TXT file. Needs to be formatted as <strong>Term,Definition</strong>
    </p>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Term</th>
                <th>Definition</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var card in usersStudySubjects)
            {
                <tr>
                    <td>
                        @if (card.EDIT_MODE)
                        {
                            <input class="form-control" @bind="card.TERM" placeholder="Term" />
                        }
                        else
                        {
                            @card.TERM
                        }
                    </td>
                    <td>
                        @if (card.EDIT_MODE)
                        {
                            <input class="form-control" @bind="card.DEFINITION" placeholder="Definition" />
                        }
                        else
                        {
                            @card.DEFINITION
                        }
                    </td>
                    <td>
                        @if (card.EDIT_MODE)
                        {
                            <button class="btn btn-success btn-sm" @onclick="() => ConfirmEdit(card)">
                                <i class="bi bi-check-lg"></i>
                            </button>
                            <button class="btn btn-secondary btn-sm ms-1" @onclick="() => CancelEdit(card)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => EditCard(card)">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-danger btn-sm ms-1" @onclick="() => DeleteCard(card)">
                                <i class="bi bi-trash"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <button class="btn btn-info" @onclick="CreateCard">
                <i class="bi bi-plus-circle"></i> New Card
            </button>
            <label class="btn btn-info ms-2">
            <i class="bi bi-upload"></i> Import File
            <InputFile OnChange="LoadFiles" style="display:none;" />
            </label>
        </div>
        <button class="btn btn-danger" @onclick="() => deleteSetFlag = true">
            <i class="bi bi-trash"></i> Delete Set
        </button>
    </div>
    <div> <br /> </div>
    <div> <br /> </div>
    <button class="btn btn-success ms-2" @onclick="SaveToDB">
        <i class="bi bi-floppy"></i> Save
    </button>
    <div> <br /> </div>
    <p>Remember to save your changes! Any changes made before will not be saved.</p>

    @if (linesWereSkipped)
    {
        <div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000;">
            <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:white; padding:2rem; border-radius:8px; min-width:300px;">
                <h5>@skippedLines line(s) were skipped due to formatting issue.</h5>
                <div class="mt-3">
                    <button class="btn btn-success" @onclick="() => linesWereSkipped = false">
                    <i class="bi bi-check-lg"></i> Confirm
                    </button>
                </div>
            </div>
        </div>
    }
    @if (saveSuccess)
    {
        <p class="text-success mt-2">✓ Changes saved successfully!</p>
    }

    @if (deleteSetFlag)
    {
        <div style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000;">
            <div style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:white; padding:2rem; border-radius:8px; min-width:300px;">
                <h5>This action will delete the entire set and cannot be undone. Are you sure? </h5>
                <div class="mt-3">
                    <button class="btn btn-success" @onclick="DeleteSet">
                        <i class="bi bi-check-lg"></i> Confirm
                    </button>
                    <button class="btn btn-secondary ms-2" @onclick="() => deleteSetFlag = false">
                        <i class="bi bi-x-lg"></i> Cancel
                    </button>
                </div>
            </div>
        </div>
    }
}
    </Authorized>
<NotAuthorized>
    <p>Access unauthorized.....</p>
</NotAuthorized>
</AuthorizeView>

@inject ILocalStorageService localStorage
@code {
@using Microsoft.Data.SqlClient;
@using StudiousWeb.Models;
@using Microsoft.AspNetCore.Components.Forms
    // Variable declaration 
    private string? errorMessage;

    // The name of the study sets and current auth user
    [Parameter] public string? StudySetName { get; set; }
    private string? currentUser;

    // lists to hold each study set. Multiple lists are used for if new cards are added or existing cards deleted.
    private List<StudyMaterialToEdit> usersStudySubjects = new();
    private List<StudyMaterialToEdit> newStudySet = new();
    private List<StudyMaterialToEdit> deletedCards = new();
    private List<string> studySets = new();

    // Boolean flags for multiple methods. 
    private bool saveSuccess = false;  // was it saved to database?
    private string? newStudySetName; // reserved for future use - may be used to track new set creation separately
    private bool showModal = false; // modal for new study set
    private bool deleteSetFlag = false; // modal for are you sure you want to delete set?

    // 1MG is the maximum size of a file that can be imported
    private const int MAX_SIZE = 1048576; 
    // Boolean flags and int to keep count if a line was unable to be imported from file
    private int skippedLines = 0;
    private bool linesWereSkipped = false;

    // hard coded connection to Database
    private string cnxnString = "Server=tcp:studious.database.windows.net,1433;Initial Catalog=StudiousDB;Persist Security Info=False;User ID=StudiousMtsuAdmin;Password=@K8zEBnmSeweZh5;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;";
    // Read the cards already exisiting in database using LoadCards method
    protected override async Task OnInitializedAsync()
    {
    // username was initial primary key for flash card table and user table
        currentUser = await localStorage.GetItemAsync<string>("username"); 
        await LoadStudySets();
        if (!string.IsNullOrEmpty(StudySetName))
            await LoadCards();
    }

    // Blazor calls this when URL parameters change. Needed separately from OnInitializedAsync
    // so navigating between sets reloads the correct cards without a full page refresh
    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(StudySetName))
            await LoadCards();
    }

    // LOAD STUDY SETS - loads all saved study sets
    private async Task LoadStudySets()
    {
        studySets.Clear();
        errorMessage = null;

        try
        {
            using SqlConnection cnxn = new SqlConnection(cnxnString);
            cnxn.Open();
            SqlCommand cmd = new SqlCommand(
                "SELECT DISTINCT STUDYSET_NAME FROM FLASH_CARDS WHERE USERNAME = @u", cnxn);
            cmd.Parameters.AddWithValue("@u", currentUser);

            using SqlDataReader reader = cmd.ExecuteReader();
            while (reader.Read())
            {
                studySets.Add(reader["STUDYSET_NAME"].ToString());
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    // LOAD CARDS - loads cards for selected study set
    private async Task LoadCards()
    {
        usersStudySubjects.Clear();
        errorMessage = null;

        try
        {
            using SqlConnection cnxn = new SqlConnection(cnxnString);
            cnxn.Open();
            SqlCommand cmd = new SqlCommand(
                "SELECT ID, USERNAME, STUDYSET_NAME, TERM, DEFINITION FROM FLASH_CARDS WHERE USERNAME = @u AND STUDYSET_NAME = @s", cnxn);
            cmd.Parameters.AddWithValue("@u", currentUser);
            cmd.Parameters.AddWithValue("@s", StudySetName);

            using SqlDataReader reader = cmd.ExecuteReader();
            while (reader.Read())
            {
                usersStudySubjects.Add(new StudyMaterialToEdit
            {
                ID = (int)reader["ID"],
                USERNAME = reader["USERNAME"].ToString(),
                STUDYSET_NAME = reader["STUDYSET_NAME"].ToString(),
                TERM = reader["TERM"].ToString(),
                DEFINITION = reader["DEFINITION"].ToString()
            });
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    // NAVIGATION METHODS 
    // takes us to selected set
    private void SelectSet(string setName)
    {
        StudySetName = setName;
        _ = LoadCards();
    }
    // takes us to page with all saved sets
    private void GoBack()
    {
        Nav.NavigateTo($"/sets");
    }

    // CREATE NEW SET - just saves new set name. Doesn't send to DB until "saved"
    private void ConfirmNewSet()
    {
        StudySetName = newStudySetName;
        showModal = false;

    }

    // CREATE CARD METHODS
    // method for individual card
    private void CreateCard()
    {
        saveSuccess = false;
        usersStudySubjects.Add(new StudyMaterialToEdit
    {
        USERNAME = currentUser,
        STUDYSET_NAME = StudySetName,
        TERM = "",
        DEFINITION = "",
        IS_NEW = true,
        EDIT_MODE = true
    });
    }
    // method for file input for multiple cards
    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        var file = e.File;

        try
        {
            // if file name is correct and less than 1MB
            if ((file.Name.EndsWith(".csv") || file.Name.EndsWith(".txt")) && file.Size < MAX_SIZE)
            {

                using var stream = file.OpenReadStream(maxAllowedSize: 1048576);
                using var reader = new StreamReader(stream);
                var content = await reader.ReadToEndAsync();

                var fileData = content.Split('\n');

                foreach (var line in fileData)
                {
                    var parts = line.Split(',');
                    if (parts.Length == 2){
                        usersStudySubjects.Add(new StudyMaterialToEdit
                        {
                            USERNAME = currentUser,
                            STUDYSET_NAME = StudySetName,
                            TERM = parts[0],
                            DEFINITION = parts[1],
                            IS_NEW = true,
                            EDIT_MODE = false
                        });
                    }
                    else
                    {
                        skippedLines++;
                    }
                }
                
                if (skippedLines > 0)
                {
                    linesWereSkipped = true;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
        
    // UPDATE METHODS
    // inline editing to cards
    private void EditCard(StudyMaterialToEdit card)
    {
        saveSuccess = false;
        card.ORIGINAL_TERM = card.TERM;
        card.ORIGINAL_DEFINITION = card.DEFINITION;
        card.EDIT_MODE = true;
    }
    // card being edited button to confirm changes, now tracked with bool flags
    private void ConfirmEdit(StudyMaterialToEdit card)
    {
        if (!card.IS_NEW)
            card.IS_DIRTY = true;
        card.EDIT_MODE = false;
    }
    // card being edited button to cancel changes, now tracked with bool flags
    private void CancelEdit(StudyMaterialToEdit card)
    {
        if (card.IS_NEW)
        {
            usersStudySubjects.Remove(card);
        }
        else
        {
            card.TERM = card.ORIGINAL_TERM;
            card.DEFINITION = card.ORIGINAL_DEFINITION;
            card.EDIT_MODE = false;
        }
    }

    // Delete Card - just removes from web page. will now be tracked with bool flag and updated in DB when "saved"
    private void DeleteCard(StudyMaterialToEdit card)
    {
        saveSuccess = false;
        if (!card.IS_NEW)
            deletedCards.Add(card);
        usersStudySubjects.Remove(card);
    }

    // Money maker right here. All tracked card/set changes, updates, deletions, creations will be updated in database.
    private async Task SaveToDB()
    {
        errorMessage = null;

        try
        {
            using SqlConnection cnxn = new SqlConnection(cnxnString);
            cnxn.Open();

            foreach (var card in usersStudySubjects.Where(c => c.IS_NEW))
            {
                SqlCommand cmd = new SqlCommand(
                    "INSERT INTO FLASH_CARDS (USERNAME, STUDYSET_NAME, TERM, DEFINITION) VALUES (@u, @s, @t, @d)", cnxn);
                cmd.Parameters.AddWithValue("@u", card.USERNAME);
                cmd.Parameters.AddWithValue("@s", card.STUDYSET_NAME);
                cmd.Parameters.AddWithValue("@t", card.TERM);
                cmd.Parameters.AddWithValue("@d", card.DEFINITION);
                await cmd.ExecuteNonQueryAsync();
                card.IS_NEW = false;
            }

            foreach (var card in usersStudySubjects.Where(c => c.IS_DIRTY))
            {
                SqlCommand cmd = new SqlCommand(
                    "UPDATE FLASH_CARDS SET TERM = @t, DEFINITION = @d WHERE ID = @id", cnxn);
                cmd.Parameters.AddWithValue("@t", card.TERM);
                cmd.Parameters.AddWithValue("@d", card.DEFINITION);
                cmd.Parameters.AddWithValue("@id", card.ID);
                await cmd.ExecuteNonQueryAsync();
                card.IS_DIRTY = false;
            }

            foreach (var card in deletedCards)
            {
                SqlCommand cmd = new SqlCommand(
                    "DELETE FROM FLASH_CARDS WHERE ID = @id", cnxn);
                cmd.Parameters.AddWithValue("@id", card.ID);
                await cmd.ExecuteNonQueryAsync();
            }

            deletedCards.Clear();
            await LoadCards();
            saveSuccess = true;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }


    // DELETE ENTIRE SET - wipes the entire study set from the database. No take backs!
    private async Task DeleteSet()
    {     
        errorMessage = null;

        try
        {
            using SqlConnection cnxn = new SqlConnection(cnxnString);
            cnxn.Open();
                        
            SqlCommand cmd = new SqlCommand(
                "DELETE FROM FLASH_CARDS WHERE USERNAME = @u AND STUDYSET_NAME = @s", cnxn);
            cmd.Parameters.AddWithValue("@s", StudySetName);
            cmd.Parameters.AddWithValue("@u", currentUser);
            await cmd.ExecuteNonQueryAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        deleteSetFlag = false;
        Nav.NavigateTo($"/sets");
        
    }

    // ICON HELPER - joy and whismy. I have loved bootstrap icons. I wanted to do more. This is only icons for study sets.
    private string GetIconForSet(string setName)
    {
        if (setName.Contains("PHYS", StringComparison.OrdinalIgnoreCase)) return "bi-stars";
        if (setName.Contains("BIO", StringComparison.OrdinalIgnoreCase)) return "bi-flower1";
        if (setName.Contains("HIST", StringComparison.OrdinalIgnoreCase)) return "bi-globe";
        if (setName.Contains("ALGEBRA", StringComparison.OrdinalIgnoreCase) ||
            setName.Contains("MATH", StringComparison.OrdinalIgnoreCase)) return "bi-calculator";
        return "bi-journal-bookmark";
    }
}