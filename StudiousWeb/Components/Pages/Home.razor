@page "/"

<div class="home-container">
    <div class="header">
        <h1>Welcome to Studious!</h1>
        <p>Your all-in-one place to create, study, and master flashcards with ease. Build your own study sets, test your knowledge, and learn faster with interactive tools.</p>
    </div>

    <div class="main-content">
        <!-- Left: Demo Card -->
        <div class="card-demo" @onclick="FlipCard">
            <div class="card @(isFlipped ? "flipped" : "")">
                <div class="card-face front">
                    <h3>Definition</h3>
                </div>
                <div class="card-face back">
                    <h3>Term</h3>
                </div>
            </div>
        </div>

        <!-- Right: Instructions -->
        <div class="instructions">
            <h2>Getting Started</h2>
            <ul>
                <li>Create an account</li>
                <li>Create your study set</li>
                <li>Add terms and definitions</li>
                <li>Start studying!</li>
            </ul>
        </div>
    </div>
</div>

@code {
    private bool isFlipped = false;

    private void FlipCard()
    {
        isFlipped = !isFlipped;
    }
}

<style>
    /* Prevent navbar stretching */
    .home-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
        font-family: Arial, sans-serif;
    }

    .header {
        text-align: center;
        margin-bottom: 40px;
    }

        .header h1 {
            font-size: 3rem;
            margin-bottom: 10px;
        }

        .header p {
            font-size: 1.2rem;
            color: #555;
        }

    .main-content {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 60px;
        flex-wrap: wrap; /* prevents layout breaking */
    }

    .card-demo {
        width: 300px;
        height: 200px;
        perspective: 1000px;
        cursor: pointer;
    }

    .card {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s;
    }

        .card.flipped {
            transform: rotateY(180deg);
        }

    .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        backface-visibility: hidden; /* critical fix */
        -webkit-backface-visibility: hidden; /* safari fix */
    }

    .front {
        background-color: #f0f0f0;
    }

    .back {
        background-color: #4CAF50;
        color: white;
        transform: rotateY(180deg);
    }

    .instructions {
        max-width: 300px;
    }

        .instructions h2 {
            margin-bottom: 15px;
        }

        .instructions ul {
            list-style-type: disc;
            padding-left: 20px;
        }

        .instructions li {
            margin-bottom: 10px;
            font-size: 1.1rem;
        }
</style>
