@page "/Login"
@rendermode InteractiveServer
@layout NoNavigationLayout

<div class="mx-auto border rounded p-3 w-50">
    <div class="d-flex justify-content-center">
        <img src="Assets\Images\Studious_Logo.svg" width="76" height="60">
        <h3 class="m-2">Studious</h3>
    </div>
    <hr />
    @if(error.Length > 0)
    {
        <div class="mx-5 row alert alert-danger alert-dismissible fade show align-items-center justify-content-center" role="alert">
            <div class="col-auto">
                <strong>@error</strong>
            </div>
        </div>
    }
    <div class="row mb-3 align-items-center justify-content-center">
        <div class="col-2 col-md-2 col-sm-auto">
            <label class="col-form-label" for="emailLoginControl">Email</label>
        </div>
        <div class="col-auto">
            <input class="form-control" type="email" id="emailLoginControl" @bind="email" />
        </div>
    </div>
    <div class="row mb-3 align-items-center justify-content-center">
        <div class="col-2 col-md-2 col-sm-auto">
            <label class="col-form-label" for="passwordLoginControl">Password</label>
        </div>
        <div class="col-auto">
            <input class="form-control" type="password" id="passwordLoginControl" @bind="password" />
        </div>
    </div>
    <div class="row mb-3 d-flex justify-content-center">
        <div class="col-auto">
            <button class="btn btn-sm btn-success" @onclick="LoginAsync">Login</button>
        </div>
        <div class="col-auto">
            <button class="btn btn-sm btn-success" @onclick="RegisterAsync">Register</button>
        </div>
    </div>
    <div class="row d-flex justify-content-center">
        <div class="col-auto">
            <p>New user? Create an account <a href="">here</a>!</p>
        </div>
    </div>

</div>

@inject AuthenticationStateProvider provider
@inject NavigationManager navigationManager // Used for redirection
@inject ILocalStorageService localStorageService
@code {
    @using System.Text.Json.Serialization.Metadata;

    private string email = "";
    private string password = "";
    private string error = "";
    private string username = "";
    private JsonTypeInfo<string>? jsonTypeInfo;

    private async Task LoginAsync()
    {
        var authStateProvider = (CustomAuthStateProvider)provider;
        var formResult = await authStateProvider.LoginAsync(email, password);

        if(formResult.Succeeded)
        {
            var data = await localStorageService.GetItemAsync("username", jsonTypeInfo);
            data!.ToString();
            navigationManager.NavigateTo("/");
        }
        else
        {
            error = formResult.Errors[0];
        }
    }

    private async Task RegisterAsync()
    {
        var authStateProvider = (CustomAuthStateProvider)provider;
        var formResult = await authStateProvider.RegisterAsync(email, password);

        if (formResult.Succeeded)
        {
           await LoginAsync();
        }
        else
        {
            error = formResult.Errors[0];
        }
    }
}
