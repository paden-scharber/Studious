@page "/study"
@page "/study/{StudySetName}"
@rendermode InteractiveServer
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
    @if (studyContents.Any() && !isError)
    {
            <div><br /></div>
            <div class="d-flex align-items-center mb-3">
                <button class="btn btn-secondary btn-sm me-3" @onclick="GoBack">
                    <i class="bi bi-arrow-left"></i> Back
                </button>
                <h3 class="mb-0">@studyItem.STUDYSET_NAME</h3>
            </div>
            <hr />
            <div class="d-flex justify-content-between align-items-center">
                <button class="btn border-0 px-2 py-0 studious-nav-bg-main"
                        style="height: 100px; width: 36px;"
                        disabled="@isBeginning"
                        @onclick="Previous">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="60" fill="white" class="bi bi-chevron-compact-left" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M9.224 1.553a.5.5 0 0 1 .223.67L6.56 8l2.888 5.776a.5.5 0 1 1-.894.448l-3-6a.5.5 0 0 1 0-.448l3-6a.5.5 0 0 1 .67-.223" />
                    </svg>
                </button>

                <div class="card-demo-flip" @onclick="FlipCard">
                    <div class="card-flip-css @(isFlipped ? "flipped-css" : "")" >
                        <div class="card-face-css front-card-css">
                            <p class="flip-header studious-nav-bg-main">Term</p>
                            <p class="flip-body">
                                @studyItem.TERM
                            </p>
                        </div>
                        <div class="card-face-css back-card-css">
                            <p class="flip-header studious-nav-bg-main">Definition</p>
                            <p class="flip-body">
                                @studyItem.DEFINITION
                            </p>
                        </div>
                    </div>
                </div>


                <button class="btn border-0 px-2 py-0 studious-nav-bg-main @(isEnd ? "disabled" : "")"
                        style="height: 100px; width: 36px;"
                        disabled="@isEnd"
                        @onclick="Next">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="60" fill="white" class="bi bi-chevron-compact-right" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M6.776 1.553a.5.5 0 0 1 .671.223l3 6a.5.5 0 0 1 0 .448l-3 6a.5.5 0 1 1-.894-.448L9.44 8 6.553 2.224a.5.5 0 0 1 .223-.671" />
                    </svg>
                </button>
            </div>
        <!-- Table view of all cards in the set. Clicking a row jumps the flip card to that card -->
        <hr class=" mt-5"/>
            <table class="table table-hover table-bordered table-responsive-sm">
                <thead>
                    <tr>
                        <th class="text-center">Term</th>
                        <th class="text-center">Definition</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var item in studyContents)
                    {
                        <tr @onclick="() => studyItem = item">
                            <td>@item.TERM</td>
                            <td>@item.DEFINITION</td>
                        </tr>
                    }
                </tbody>
            </table>

        }
    else
    {
        <p>Error loading content, please reload the browser or contact the administrator.</p>
    }
    </Authorized>
    <NotAuthorized>
        <p>Access denied.</p>
    </NotAuthorized>
</AuthorizeView>

@inject ILocalStorageService localStorage
@code {

    // variables for study srt name and current user
    [Parameter] public string? StudySetName { get; set; }
    private string? currentUser;

    // list for all study content items 
    private List<StudyContent> studyContents;
    private StudyContent studyItem; // the single card currently being displayed on the flip card

    // tracks which card we are on and how many cards total are in the set
    private int currentIndex = 0;
    private int total;
    
    // bool flags

    private bool isFlipped = false;
    private bool isError = false;

    // isBeginning and isEnd disable the prev/next buttons at the edges of the set
    private bool isBeginning = true;
    private bool isEnd = false;

    // database connection string
    private readonly string cnxnString = "Server=tcp:studious.database.windows.net,1433;Initial Catalog=StudiousDB;Persist Security Info=False;User ID=StudiousMtsuAdmin;Password=@K8zEBnmSeweZh5;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;";

    // On page load, grab the logged in user from local storage then load their study sets
    protected override async Task OnInitializedAsync()
    {
        studyContents = new List<StudyContent>();
        currentUser = await localStorage.GetItemAsync<string>("username");
        isError = false;
        try
        {
            using (SqlConnection cnxn = new SqlConnection(cnxnString))
            {
                cnxn.Open();
                SqlCommand cmd = new SqlCommand(
                       "SELECT ID, USERNAME, STUDYSET_NAME, TERM, DEFINITION FROM FLASH_CARDS WHERE USERNAME = @u AND STUDYSET_NAME = @s", cnxn);
                cmd.Parameters.AddWithValue("@u", currentUser);
                cmd.Parameters.AddWithValue("@s", StudySetName);
                using(SqlDataReader reader = cmd.ExecuteReader())
                {
                    while (reader.Read())
                    { 
                        StudyContent content = new StudyContent();
                        content.ID = (int)reader["ID"];
                        content.USERNAME = reader["USERNAME"].ToString();
                        content.STUDYSET_NAME = reader["STUDYSET_NAME"].ToString();
                        content.TERM = reader["TERM"].ToString();
                        content.DEFINITION = reader["DEFINITION"].ToString();

                        studyContents.Add(content);
                    }
                    total = studyContents.Count();
                    studyItem = studyContents[currentIndex];
                }
            }
        }
        catch (Exception ex)
        {
            isError = true;
        }
    }
    // method to set bool flag for front/back display of card
    private void FlipCard()
    {
        isFlipped = !isFlipped;    
    }
    // method to go forward on flip card set
    private void Next()
    {
        if (currentIndex < total - 1)
        {
            if (isFlipped) isFlipped = false;
            currentIndex++;
            isBeginning = currentIndex == 0;
            isEnd = currentIndex == total - 1;
            studyItem = studyContents[currentIndex];
        }
    }
    // method to go back on flip card 
    private void Previous()
    {
        if (currentIndex > 0)
        {
            if (isFlipped) isFlipped = false;
            currentIndex--;
            isBeginning = currentIndex == 0;
            isEnd = currentIndex == total - 1;
            studyItem = studyContents[currentIndex];
        }
    }
    // go back button method to go back to study set displays
    private void GoBack()
    {
        Nav.NavigateTo($"/sets");
    }
}
<!--CSS styling for the card flip. Had to completely ignore all bootstrap styling because CSS and Bootstrap were fighting-->
<!--this was unbelievably painful, claps for team-->
<style>
    .card-demo-flip {
        width: 50%;
        height: 250px;
        perspective: 1000px;
        cursor: pointer;
    }

    .card-flip-css {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s; 
        display: block !important;
        flex-direction: unset !important;
    }

    .flipped-css {
        transform: rotateY(180deg);
    }

       .card-face-css {
        flex-direction: column;
        justify-content: flex-start;
        position: absolute;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        backface-visibility: hidden !important;
        -webkit-backface-visibility: hidden !important;
    }

    .back-card-css {
        background-color: #f0f0f0;
        transform: rotateY(-180deg);
    }

    .front-card-css {
        background-color: #f0f0f0;
    }

    .flip-header {
        width: 100%;
        text-align: center;
        padding: 10px;
        color: white;
        border-radius: 12px 12px 0 0;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        font-weight: bold;
    }

    .flip-body {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        text-align: center;
        padding: 20px;
    }


    
</style>