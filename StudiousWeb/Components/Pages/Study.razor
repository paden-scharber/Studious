@page "/study"
@rendermode InteractiveServer

<h3>StudyMaterial</h3>

<div class="flash-card">
    <p></p>
</div>


<table class="table table-bordered">
    <thead>
        <tr>
            <th>User</th>
            <th>Study Set</th>
            <th>Term</th>
            <th>Definition</th>
        </tr>
    </thead>
    <tbody>
        @if (!studyMaterial.Any())
        {
            <p>Loading....</p>
        } 
        else
        {
            @foreach (var line in studyMaterial)
            {
                <tr>
                    <td>@line.USERNAME</td>
                    <td>@line.STUDYSET_NAME</td>
                    <td>@line.TERM</td>
                    <td>@line.DEFINITION</td>
                    <td>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteLine(line)">Delete</button>
                        <button>Update</button>
                    </td>
                </tr>
            }
        }

    </tbody>
</table>

<button>Save</button>

@code {
    @using Microsoft.Extensions.Configuration;
    @using Microsoft.Data.SqlClient;
    @using StudiousWeb.Models;

    private List<StudyMaterial> studyMaterial;

    protected override async Task OnInitializedAsync()
    {
        studyMaterial = new List<StudyMaterial>();
        var cnxnString = "Server=tcp:studious.database.windows.net,1433;Initial Catalog=StudiousDB;Persist Security Info=False;User ID=StudiousMtsuAdmin;Password=@K8zEBnmSeweZh5;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;";

        try
        {
            using (SqlConnection cnxn = new SqlConnection(cnxnString))
            {
                cnxn.Open();
                SqlCommand cmd = new SqlCommand("SELECT * FROM FLASH_CARDS", cnxn);
                using(SqlDataReader reader = cmd.ExecuteReader())
                {
                    while (reader.Read())
                    {
                        StudyMaterial studyShit = new StudyMaterial();

                        studyShit.USERNAME = reader[0].ToString();
                        studyShit.STUDYSET_NAME = reader[1].ToString();
                        studyShit.TERM = reader[2].ToString();
                        studyShit.DEFINITION = reader[3].ToString();

                        studyMaterial.Add(studyShit);
                    }
                }
            }
        }
        catch (Exception ex)
        {
        }
    }

    /// <summary>
    /// Deletes a study item from the set per user input.
    /// </summary>
    /// <param name="shit"></param>
    private void DeleteLine(StudyMaterial shit)
    {
        studyMaterial.Remove(shit);
    }
}
